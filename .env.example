# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Create the roles and database first: scripts/db/setup-roles.sql
# Why there are two datasources: docs/persistence.md

SPRING_PROFILES_ACTIVE='dev'


# Flyway, at startup. Owns the schema, holds DDL rights.
FLYWAY_URL='jdbc:postgresql://localhost:5432/sgt'
FLYWAY_USERNAME='sgt_migrator'
FLYWAY_PASSWORD='sgt_migrator'


# The running app. DML only.
# Behind PgBouncer, use its port and add prepareThreshold=0 - docs/scaling.md
DB_URL='jdbc:postgresql://localhost:5432/sgt'
DB_USERNAME='sgt_app'
DB_PASSWORD='sgt_app'


# The beneficiary registry (beneficiarios service), read through its v1 API.
BENEFICIARIES_URL='http://localhost:8081'


# The staff directory, read through its v3 API.
DIRECTORY_URL='http://localhost:8082'


# poi, the operational plan service, read and written through its v1 task API.
POI_URL='http://localhost:8083'

# The S3-compatible object store holding field sheets' scanned PDFs.
SCANS_ENDPOINT='http://localhost:9000'
SCANS_REGION='us-east-1'
SCANS_BUCKET='field-sheets'
SCANS_ACCESS_KEY='changeme_access_key'
SCANS_SECRET_KEY='changeme_secret_key'


# staff, the identity provider. Only tokens it issued to a person for
# SGT_TOKEN_AUDIENCE are accepted: STAFF_ISSUER must match staff's own, and the
# audience is the identifier this deployment of sgt is registered under there.
STAFF_ISSUER='http://localhost:8082'
SGT_TOKEN_AUDIENCE='sgt-api-dev'

# The origin the frontend's browser calls come from.
SGT_WEB_ORIGIN='http://localhost:5173'


# sgt as a service of its own, as staff registered it in this environment's
# seed: its client id and secret, and the identifiers poi and the directory are
# registered under there. sgt gets a token per API with these.
SGT_SERVICE_CLIENT_ID='sgt-service-dev'
SGT_SERVICE_CLIENT_SECRET='sgt-service-dev-secret'
POI_TOKEN_AUDIENCE='poi-api-dev'
DIRECTORY_TOKEN_AUDIENCE='staff-directory-api-dev'
BENEFICIARIES_TOKEN_AUDIENCE='beneficiarios-api-dev'
