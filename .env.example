# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Create the roles and database first: scripts/db/setup-roles.sql
# Why there are two datasources: docs/persistence.md

SPRING_PROFILES_ACTIVE='dev'


# Flyway, at startup. Owns the schema, holds DDL rights.
FLYWAY_URL='jdbc:postgresql://localhost:5432/sgt'
FLYWAY_USERNAME='sgt_migrator'
FLYWAY_PASSWORD='sgt_migrator'


# The running app. DML only.
# Behind PgBouncer, use its port and add prepareThreshold=0 - docs/scaling.md
DB_URL='jdbc:postgresql://localhost:5432/sgt'
DB_USERNAME='sgt_app'
DB_PASSWORD='sgt_app'


# The beneficiary registry (beneficiarios service), read through its v2 API.
BENEFICIARIES_URL='http://localhost:8081'
BENEFICIARIES_API_KEY='secret-dev-key'


# The staff directory, read through its v2 API for field agents.
FIELD_AGENTS_URL='http://localhost:8082'
FIELD_AGENTS_API_KEY='secret-dev-key'


# poi, the operational plan service, read and written through its v1 task API.
POI_URL='http://localhost:8083'
POI_API_KEY='changeme_api_key'

# The S3-compatible object store holding field sheets' scanned PDFs.
SCANS_ENDPOINT='http://localhost:9000'
SCANS_REGION='us-east-1'
SCANS_BUCKET='field-sheets'
SCANS_ACCESS_KEY='changeme_access_key'
SCANS_SECRET_KEY='changeme_secret_key'
